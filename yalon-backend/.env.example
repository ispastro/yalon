# ============================================================
# YALON BACKEND — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=3000

# Allowed CORS origin — set to your frontend URL in production.
# Use * only for local development.
ALLOWED_ORIGIN=http://localhost:5500

# ── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Use the service_role key (never the anon key) — it bypasses RLS.
# Keep this secret — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Brevo SMTP (email notifications) ────────────────────────
# Get credentials from: Brevo dashboard → SMTP & API → SMTP
BREVO_SMTP_USER=your-smtp-user@smtp-brevo.com
BREVO_SMTP_PASS=your-smtp-password

# The "From" address on outgoing notification emails.
SENDER_EMAIL=you@yourdomain.com

# The internal address that receives new request/application alerts.
RECEIVER_EMAIL=you@yourdomain.com

# ── Supabase Storage ─────────────────────────────────────────
# Must match the bucket name created in Supabase Storage.
# Keep the bucket PRIVATE (not public).
EMPLOYEE_DOCS_BUCKET=employee-documents
